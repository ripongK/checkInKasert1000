<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ลงเวลาเข้างาน</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;600;700&display=swap" rel="stylesheet">
<script charset="utf-8" src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
<style>
  :root {
    --field: #173B22;      /* เขียวไร่เข้ม */
    --leaf: #2F6B3A;       /* เขียวใบ */
    --paddy: #EEF3E6;      /* พื้นหลังเขียวนา */
    --soil: #7A5230;       /* น้ำตาลดิน */
    --grain: #E9B949;      /* เหลืองรวงข้าว (รอตรวจสอบ) */
    --alert: #B3261E;
    --ink: #1D261F;
    --muted: #5C6B5F;
    --paper: #FFFFFF;
    --font: "IBM Plex Sans Thai", "Noto Sans Thai", "Leelawadee UI", Tahoma, sans-serif;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; }
  body {
    background: var(--paddy); color: var(--ink); font-family: var(--font);
    font-size: 17px; line-height: 1.6; -webkit-tap-highlight-color: transparent;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .bar {
    position: sticky; top: 0; z-index: 5; display: flex; justify-content: space-between; align-items: center;
    background: var(--field); color: #fff; padding: 12px 20px;
    padding-top: calc(12px + env(safe-area-inset-top, 0px));
  }
  .brand { font-weight: 700; font-size: 1.05rem; }
  .clock { font-variant-numeric: tabular-nums; font-weight: 600; font-size: 1.1rem; }
  main { max-width: 480px; margin: 0 auto; padding: 24px 20px 40px; }
  .screen { display: none; }
  .screen.active { display: block; }
  h1 { font-size: 1.5rem; line-height: 1.3; margin: 0 0 8px; }
  p { margin: 0 0 16px; }
  .sub { color: var(--muted); font-size: .92rem; }
  .msg { color: var(--alert); font-weight: 600; min-height: 1.6em; margin: 10px 0; }

  .btn {
    display: block; width: 100%; min-height: 52px; border-radius: 12px; border: 2px solid transparent;
    font: 600 1.05rem var(--font); cursor: pointer; margin-top: 12px; padding: 10px 16px;
  }
  .btn:focus-visible, input:focus-visible { outline: 3px solid var(--grain); outline-offset: 2px; }
  .btn.primary { background: var(--leaf); color: #fff; }
  .btn.primary:disabled { background: #9DB3A0; }
  .btn.secondary { background: var(--paper); color: var(--leaf); border-color: var(--leaf); }
  .btn.ghost { background: transparent; color: var(--muted); }
  .btn.big { min-height: 64px; font-size: 1.15rem; }
  .row2 { display: grid; grid-template-columns: 1fr 2fr; gap: 12px; }

  /* ลงทะเบียน */
  .code-input {
    width: 100%; font: 700 2rem var(--font); text-align: center; letter-spacing: .4em;
    padding: 12px; border: 2px solid var(--leaf); border-radius: 12px; background: var(--paper);
    font-variant-numeric: tabular-nums; margin-top: 8px;
  }

  /* หน้าแรก */
  .who { border-left: 6px solid var(--soil); padding: 4px 0 4px 14px; margin-bottom: 22px; }
  .who-name { font-size: 1.45rem; font-weight: 700; line-height: 1.3; }
  .who-meta { color: var(--muted); }
  .gps-box {
    display: flex; gap: 12px; align-items: center; background: var(--paper);
    border-radius: 12px; padding: 14px 16px; margin-bottom: 16px;
  }
  .gps-dot { flex: none; width: 14px; height: 14px; border-radius: 50%; background: #A7B2A9; }
  .gps-box.searching .gps-dot { animation: pulse 1.2s infinite; }
  .gps-box.good .gps-dot { background: var(--leaf); }
  .gps-box.ok .gps-dot { background: var(--grain); }
  .gps-box.bad .gps-dot { background: var(--alert); }
  #gpsText { font-weight: 600; }
  @keyframes pulse { 50% { opacity: .25; } }
  @media (prefers-reduced-motion: reduce) { .gps-box.searching .gps-dot { animation: none; } }
  .tips { background: #E2EAD8; border-radius: 12px; padding: 12px 16px; font-size: .95rem; }
  .tips ol { margin: 4px 0 0; padding-left: 20px; }

  /* กล้อง */
  #scr-camera.active { position: fixed; inset: 0; z-index: 20; background: #000; display: flex; flex-direction: column; }
  .cam-wrap { position: relative; flex: 1; overflow: hidden; }
  #video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
  .face-guide {
    position: absolute; left: 50%; top: 14%; width: 46%; aspect-ratio: 3/4; transform: translateX(-50%);
    border: 3px dashed rgba(255,255,255,.75); border-radius: 50%;
  }
  .cam-note {
    position: absolute; left: 0; right: 0; top: calc(12px + env(safe-area-inset-top, 0px));
    text-align: center; color: #fff; font-weight: 600; text-shadow: 0 1px 3px #000; padding: 0 16px;
  }
  .cam-actions {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 18px 20px calc(18px + env(safe-area-inset-bottom, 0px));
  }
  .cam-actions .btn { margin: 0; color: #fff; width: auto; }
  .shutter {
    width: 78px; height: 78px; border-radius: 50%; background: #fff;
    border: 6px solid rgba(255,255,255,.45); background-clip: padding-box; cursor: pointer;
  }
  .shutter:active { transform: scale(.94); }

  .photo { display: block; width: 100%; border-radius: 12px; background: #ccc; }

  /* ผลลัพธ์ */
  .status {
    display: inline-block; padding: 6px 14px; border-radius: 999px; font-weight: 700; margin-bottom: 14px;
  }
  .status.pass { background: var(--leaf); color: #fff; }
  .status.pending { background: var(--grain); color: var(--ink); }
  .receipt-img { display: block; width: 100%; border-radius: 8px; box-shadow: 0 2px 0 var(--soil); }

  .spinner {
    width: 44px; height: 44px; border-radius: 50%; margin: 60px auto 18px;
    border: 5px solid #CFDCC8; border-top-color: var(--leaf); animation: spin 1s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .center { text-align: center; }
</style>
</head>
<body>

<header class="bar">
  <div class="brand">ลงเวลาเข้างาน</div>
  <div class="clock" id="clock">--:--</div>
</header>

<main>
  <!-- กำลังโหลด -->
  <section id="scr-loading" class="screen active center">
    <div class="spinner"></div>
    <p id="loadingText">กำลังเปิดแอป…</p>
  </section>

  <!-- ลงทะเบียน -->
  <section id="scr-register" class="screen">
    <h1>ลงทะเบียนครั้งแรก</h1>
    <p class="sub">กรอกรหัสพนักงาน 5 หลัก เพื่อผูกกับบัญชี LINE นี้ ทำเพียงครั้งเดียว</p>
    <input id="empCode" class="code-input" inputmode="numeric" maxlength="5" autocomplete="off" placeholder="00000" aria-label="รหัสพนักงาน 5 หลัก">
    <div class="msg" id="regMsg"></div>
    <button id="btnRegister" class="btn primary big">ลงทะเบียน</button>
  </section>

  <!-- หน้าแรก -->
  <section id="scr-home" class="screen">
    <div class="who">
      <div class="who-name" id="empName"></div>
      <div class="who-meta" id="empMeta"></div>
    </div>
    <div class="gps-box searching" id="gpsBox">
      <div class="gps-dot"></div>
      <div>
        <div id="gpsText">กำลังค้นหาตำแหน่ง…</div>
        <div class="sub" id="gpsSub">เปิด GPS และอยู่ในที่โล่งจะเร็วขึ้น</div>
      </div>
    </div>
    <div class="tips">
      วิธีถ่ายเซลฟี่ให้ผ่านการตรวจสอบ
      <ol>
        <li>ยืนหน้าร้าน ให้เห็นป้ายหรือหน้าร้านอยู่ด้านหลัง</li>
        <li>ให้เห็นใบหน้าชัด ไม่สวมแว่นดำหรือหมวกปิดหน้า</li>
      </ol>
    </div>
    <div class="msg" id="homeMsg"></div>
    <button id="btnOpenCam" class="btn primary big">เปิดกล้องถ่ายเซลฟี่</button>
  </section>

  <!-- กล้อง -->
  <section id="scr-camera" class="screen">
    <div class="cam-wrap">
      <video id="video" playsinline autoplay muted></video>
      <div class="face-guide"></div>
      <div class="cam-note">วางหน้าในกรอบ ให้เห็นร้านค้าด้านหลัง</div>
    </div>
    <div class="cam-actions">
      <button id="btnCancelCam" class="btn ghost">ยกเลิก</button>
      <button id="btnShutter" class="shutter" aria-label="ถ่ายรูป"></button>
      <span></span>
    </div>
  </section>

  <!-- ตรวจรูปก่อนส่ง -->
  <section id="scr-preview" class="screen">
    <h1>ตรวจรูปก่อนยืนยัน</h1>
    <img id="previewImg" class="photo" alt="รูปเซลฟี่ที่ถ่าย">
    <div class="msg" id="previewMsg"></div>
    <div class="row2">
      <button id="btnRetake" class="btn secondary">ถ่ายใหม่</button>
      <button id="btnSubmit" class="btn primary">ยืนยันลงเวลา</button>
    </div>
  </section>

  <!-- ใบยืนยัน -->
  <section id="scr-result" class="screen">
    <div id="statusPill" class="status pass"></div>
    <img id="receiptImg" class="receipt-img" alt="ใบยืนยันการลงเวลาเข้างาน">
    <p class="sub center" id="saveHint" style="margin-top:10px">กดค้างที่รูปเพื่อบันทึกลงเครื่องได้เช่นกัน</p>
    <button id="btnSave" class="btn primary">บันทึกรูปใบยืนยัน</button>
    <button id="btnSend" class="btn secondary">ส่งใบยืนยันเข้าแชท</button>
    <div class="msg" id="resultMsg"></div>
    <button id="btnClose" class="btn ghost">ปิดแอป</button>
  </section>

  <!-- ข้อผิดพลาด -->
  <section id="scr-error" class="screen">
    <h1>ทำรายการไม่สำเร็จ</h1>
    <p id="errorText"></p>
    <button id="btnRetry" class="btn primary">ลองใหม่</button>
  </section>
</main>

<input type="file" id="fileFallback" accept="image/*" capture="user" hidden>
<canvas id="canvas" hidden></canvas>

<script>
/* ================== ตั้งค่า ================== */
const LIFF_ID = '2011851937-J50DkN7z';
const API_URL = 'https://script.google.com/macros/s/AKfycby70Kg2iq4ameMBOTHHm3qKKJqkl_rvVE6chIft89gNfk-qbjGVzSKOhyB0upHx8pHj/exec';
const GPS_GOOD_ACCURACY = 30;   // เมตร: แม่นยำดี
const GPS_MAX_ACCURACY = 150;   // เมตร: ต้องตรงกับ MAX_GPS_ACCURACY_M ใน Code.gs
const FONT = '"IBM Plex Sans Thai", "Noto Sans Thai", Tahoma, sans-serif';

const TH_MONTHS = ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];
const TH_DAYS = ['อาทิตย์','จันทร์','อังคาร','พุธ','พฤหัสบดี','ศุกร์','เสาร์'];

const $ = id => document.getElementById(id);
const state = { employee: null, position: null, capturePos: null, photo: null,
                stream: null, watchId: null, record: null, receiptBlob: null, busy: false, sent: false };

/* ================== ตัวช่วยหน้าจอ ================== */
function show(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.toggle('active', s.id === id));
  window.scrollTo(0, 0);
}
function loading(text) { $('loadingText').textContent = text; show('scr-loading'); }
function showError(message, retry) {
  $('errorText').textContent = message;
  $('btnRetry').onclick = retry || (() => location.reload());
  show('scr-error');
}
setInterval(() => {
  $('clock').textContent = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
}, 1000);

function thaiDate(d) {
  return `วัน${TH_DAYS[d.getDay()]} ${d.getDate()} ${TH_MONTHS[d.getMonth()]} ${d.getFullYear() + 543}`;
}

/* ================== เรียก Backend ================== */
function getIdToken() {
  const dec = liff.getDecodedIDToken();
  if (!dec || dec.exp * 1000 < Date.now() + 30000) {
    if (liff.isInClient()) throw new Error('การเข้าสู่ระบบหมดอายุ กรุณาปิดแอปแล้วเปิดใหม่จากเมนู LINE');
    liff.login({ redirectUri: location.href });
    throw new Error('กำลังเข้าสู่ระบบใหม่…');
  }
  return liff.getIDToken();
}

async function api(action, data = {}) {
  const body = JSON.stringify(Object.assign({ action, idToken: getIdToken() }, data));
  let res;
  try {
    res = await fetch(API_URL, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body });
  } catch (e) {
    throw new Error('เชื่อมต่ออินเทอร์เน็ตไม่ได้ กรุณาตรวจสอบสัญญาณแล้วลองใหม่');
  }
  if (!res.ok) throw new Error('เซิร์ฟเวอร์ตอบกลับผิดพลาด (' + res.status + ')');
  const json = await res.json();
  if (!json.ok) throw new Error(json.message || 'เกิดข้อผิดพลาดที่ไม่ทราบสาเหตุ');
  return json;
}

/* ================== เริ่มต้น ================== */
async function main() {
  try {
    loading('กำลังเชื่อมต่อ LINE…');
    await liff.init({ liffId: LIFF_ID });
    if (!liff.isLoggedIn()) { liff.login({ redirectUri: location.href }); return; }
    loading('กำลังตรวจสอบข้อมูลพนักงาน…');
    const r = await api('profile');
    if (r.registered) { setEmployee(r.employee); goHome(); }
    else show('scr-register');
  } catch (e) {
    showError(e.message);
  }
}

function setEmployee(emp) {
  state.employee = emp;
  $('empName').textContent = emp.name;
  $('empMeta').textContent = `รหัส ${emp.code}  ${emp.position || ''}`;
}

function goHome() {
  $('homeMsg').textContent = '';
  show('scr-home');
  startGps();
}

/* ================== ลงทะเบียน ================== */
$('empCode').addEventListener('input', e => { e.target.value = e.target.value.replace(/\D/g, '').slice(0, 5); });
$('btnRegister').onclick = async () => {
  const code = $('empCode').value.trim();
  if (!/^\d{5}$/.test(code)) { $('regMsg').textContent = 'กรุณากรอกรหัสเป็นตัวเลข 5 หลัก'; return; }
  try {
    loading('กำลังลงทะเบียน…');
    const r = await api('register', { employeeCode: code });
    setEmployee(r.employee);
    goHome();
  } catch (e) {
    show('scr-register');
    $('regMsg').textContent = e.message;
  }
};

/* ================== GPS ================== */
function startGps() {
  if (state.watchId !== null) return;
  if (!navigator.geolocation) { setGps('bad', 'อุปกรณ์นี้ไม่รองรับ GPS', ''); return; }
  setGps('searching', 'กำลังค้นหาตำแหน่ง…', 'เปิด GPS และอยู่ในที่โล่งจะเร็วขึ้น');
  state.watchId = navigator.geolocation.watchPosition(pos => {
    const p = { lat: pos.coords.latitude, lng: pos.coords.longitude, accuracy: pos.coords.accuracy, time: Date.now() };
    const old = state.position;
    if (!old || p.accuracy <= old.accuracy || Date.now() - old.time > 15000) state.position = p;
    updateGpsUi();
  }, err => {
    if (err.code === err.PERMISSION_DENIED) {
      setGps('bad', 'ไม่ได้รับอนุญาตให้ใช้ตำแหน่ง', 'เปิดการตั้งค่าเครื่อง > LINE > ตำแหน่ง แล้วเลือก "อนุญาต"');
    } else {
      setGps('bad', 'หาตำแหน่งไม่พบ', 'ตรวจสอบว่าเปิด GPS แล้ว และลองออกไปที่โล่ง');
    }
  }, { enableHighAccuracy: true, maximumAge: 0, timeout: 30000 });
}

function stopGps() {
  if (state.watchId !== null) navigator.geolocation.clearWatch(state.watchId);
  state.watchId = null;
}

function updateGpsUi() {
  const p = state.position;
  if (!p) return;
  const acc = Math.round(p.accuracy);
  const coords = `${p.lat.toFixed(5)}, ${p.lng.toFixed(5)}`;
  if (acc <= GPS_GOOD_ACCURACY) setGps('good', `พบตำแหน่งแล้ว (คลาดเคลื่อน ±${acc} ม.)`, coords);
  else if (acc <= GPS_MAX_ACCURACY) setGps('ok', `พบตำแหน่งแล้ว (คลาดเคลื่อน ±${acc} ม.)`, coords + '  รอสักครู่จะแม่นยำขึ้น');
  else setGps('bad', `สัญญาณ GPS อ่อน (±${acc} ม.)`, 'ออกไปที่โล่ง แล้วรอสักครู่');
}

function setGps(cls, text, sub) {
  $('gpsBox').className = 'gps-box ' + cls;
  $('gpsText').textContent = text;
  $('gpsSub').textContent = sub;
}

/* ================== กล้อง ================== */
$('btnOpenCam').onclick = openCamera;
$('btnCancelCam').onclick = () => { stopCamera(); goHome(); };
$('btnShutter').onclick = () => {
  const v = $('video');
  if (!v.videoWidth) return;
  state.capturePos = state.position;
  drawWatermarked(v, v.videoWidth, v.videoHeight);
  stopCamera();
};
$('btnRetake').onclick = openCamera;

async function openCamera() {
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) { $('fileFallback').click(); return; }
  try {
    state.stream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 960 } }, audio: false
    });
    const v = $('video');
    v.srcObject = state.stream;
    show('scr-camera');
    await v.play();
  } catch (e) {
    stopCamera();
    if (e.name === 'NotAllowedError') {
      showError('ไม่ได้รับอนุญาตให้ใช้กล้อง กรุณาเปิดการตั้งค่าเครื่อง > LINE > กล้อง แล้วเลือก "อนุญาต"', goHome);
    } else {
      $('fileFallback').click();
    }
  }
}

function stopCamera() {
  if (state.stream) state.stream.getTracks().forEach(t => t.stop());
  state.stream = null;
}

// สำรอง: เครื่องที่เปิดกล้องสดไม่ได้ จะใช้กล้องของระบบแทน และไม่รับรูปเก่า
$('fileFallback').onchange = e => {
  const f = e.target.files[0];
  e.target.value = '';
  if (!f) return;
  if (Date.now() - f.lastModified > 2 * 60 * 1000) {
    showError('ใช้ได้เฉพาะรูปที่ถ่ายใหม่ขณะอยู่ที่ร้านเท่านั้น กรุณาถ่ายรูปใหม่', goHome);
    return;
  }
  const img = new Image();
  img.onload = () => {
    state.capturePos = state.position;
    drawWatermarked(img, img.naturalWidth, img.naturalHeight);
    URL.revokeObjectURL(img.src);
  };
  img.src = URL.createObjectURL(f);
};

document.addEventListener('visibilitychange', () => {
  if (document.hidden && state.stream) { stopCamera(); goHome(); }
});

/* ================== ประทับข้อมูลลงบนรูป ================== */
function drawWatermarked(src, sw, sh) {
  const maxW = 960;
  const scale = Math.min(1, maxW / sw);
  const w = Math.round(sw * scale), h = Math.round(sh * scale);
  const c = $('canvas');
  c.width = w; c.height = h;
  const ctx = c.getContext('2d');
  ctx.drawImage(src, 0, 0, w, h);

  const now = new Date();
  const p = state.capturePos;
  const emp = state.employee;
  const lines = [
    `${emp.code}  ${emp.name}`,
    `${thaiDate(now)}  ${now.toLocaleTimeString('th-TH')} น.`,
    p ? `GPS ${p.lat.toFixed(6)}, ${p.lng.toFixed(6)}  (±${Math.round(p.accuracy)} ม.)` : 'GPS: ยังหาตำแหน่งไม่พบ'
  ];
  const fs = Math.max(16, Math.round(w / 34));
  const lh = fs * 1.4, pad = fs * 0.7;
  const bandH = lines.length * lh + pad * 2;
  ctx.fillStyle = 'rgba(23,59,34,0.80)';
  ctx.fillRect(0, h - bandH, w, bandH);
  ctx.fillStyle = '#fff';
  ctx.font = `600 ${fs}px ${FONT}`;
  ctx.textBaseline = 'top';
  lines.forEach((t, i) => ctx.fillText(t, pad, h - bandH + pad + i * lh));

  state.photo = c.toDataURL('image/jpeg', 0.82);
  $('previewImg').src = state.photo;
  $('previewMsg').textContent = '';
  show('scr-preview');
}

/* ================== ส่งลงเวลา ================== */
$('btnSubmit').onclick = async () => {
  if (state.busy) return;
  const p = state.capturePos || state.position;
  if (!p) { $('previewMsg').textContent = 'ยังหาตำแหน่ง GPS ไม่พบ กรุณารอสักครู่แล้วถ่ายใหม่'; return; }
  if (p.accuracy > GPS_MAX_ACCURACY) { $('previewMsg').textContent = 'สัญญาณ GPS ยังไม่แม่นยำพอ กรุณาออกไปที่โล่งแล้วถ่ายใหม่'; return; }

  state.busy = true;
  loading('กำลังตรวจสอบตำแหน่งและบันทึกข้อมูล…');
  try {
    const r = await api('checkin', { lat: p.lat, lng: p.lng, accuracy: p.accuracy, photo: state.photo });
    state.record = r.record;
    stopGps();
    await renderReceipt(r.record);
    const pass = r.record.status.indexOf('ผ่าน') === 0;
    $('statusPill').className = 'status ' + (pass ? 'pass' : 'pending');
    $('statusPill').textContent = (pass ? '✓ ' : '! ') + r.record.status;
    show('scr-result');
  } catch (e) {
    show('scr-preview');
    $('previewMsg').textContent = e.message;
  } finally {
    state.busy = false;
  }
};

/* ================== สร้างใบยืนยัน (รูป PNG) ================== */
function wrapText(ctx, text, maxW) {
  const str = String(text);
  const segs = (window.Intl && Intl.Segmenter)
    ? Array.from(new Intl.Segmenter('th', { granularity: 'word' }).segment(str), s => s.segment)
    : Array.from(str);
  const lines = [];
  let line = '';
  for (const s of segs) {
    const test = line + s;
    if (ctx.measureText(test).width > maxW && line) { lines.push(line); line = s.trimStart(); }
    else line = test;
  }
  if (line) lines.push(line);
  return lines.length ? lines : ['-'];
}

function loadImage(src) {
  return new Promise((ok, fail) => { const i = new Image(); i.onload = () => ok(i); i.onerror = fail; i.src = src; });
}

async function renderReceipt(r) {
  try { await document.fonts.load(`700 40px "IBM Plex Sans Thai"`); } catch (e) {}
  const W = 1080, P = 64;
  const c = document.createElement('canvas');
  c.width = W; c.height = 4000;
  const ctx = c.getContext('2d');
  ctx.textBaseline = 'top';
  ctx.fillStyle = '#FFFFFF';
  ctx.fillRect(0, 0, W, c.height);

  // ส่วนหัว
  ctx.fillStyle = '#173B22';
  ctx.fillRect(0, 0, W, 170);
  ctx.fillStyle = '#FFFFFF';
  ctx.font = `700 50px ${FONT}`;
  ctx.fillText('ใบยืนยันการลงเวลาเข้างาน', P, 40);
  ctx.font = `400 30px ${FONT}`;
  ctx.fillText('เลขที่อ้างอิง ' + r.refNo, P, 110);

  // เวลาตัวใหญ่
  let y = 210;
  ctx.fillStyle = '#1D261F';
  ctx.font = `700 120px ${FONT}`;
  ctx.fillText(r.time.replace(' น.', ''), P, y);
  y += 150;
  ctx.font = `600 38px ${FONT}`;
  ctx.fillText(`วัน${r.day}ที่ ${r.date}`, P, y);
  y += 70;

  // ป้ายสถานะ
  const pass = r.status.indexOf('ผ่าน') === 0;
  ctx.font = `700 32px ${FONT}`;
  const sw = ctx.measureText(r.status).width + 56;
  ctx.fillStyle = pass ? '#2F6B3A' : '#E9B949';
  ctx.beginPath();
  if (ctx.roundRect) ctx.roundRect(P, y, sw, 60, 30); else ctx.rect(P, y, sw, 60);
  ctx.fill();
  ctx.fillStyle = pass ? '#FFFFFF' : '#1D261F';
  ctx.fillText(r.status, P + 28, y + 11);
  y += 100;

  // รูปเซลฟี่ (ตัดให้พอดีกรอบ)
  const img = await loadImage(state.photo);
  const boxW = W - P * 2, boxH = 760;
  const s = Math.max(boxW / img.width, boxH / img.height);
  const sw2 = boxW / s, sh2 = boxH / s;
  ctx.drawImage(img, (img.width - sw2) / 2, (img.height - sh2) / 2, sw2, sh2, P, y, boxW, boxH);
  y += boxH + 50;

  // ตารางข้อมูล
  const rows = [
    ['รหัสพนักงาน', r.code],
    ['ชื่อ-นามสกุล', r.name],
    ['ตำแหน่ง', r.position],
    ['วันที่', r.date],
    ['วัน', r.day],
    ['เวลา', r.time],
    ['สถานที่', r.address],
    ['พิกัด GPS', `${r.gps} (±${r.accuracy} ม.)`],
    ['ใกล้ที่สุด', r.nearest],
    ['พิกัดร้าน/แลนด์มาร์ค', r.nearestGps],
    ['ระยะห่าง', r.distance !== '' ? r.distance + ' เมตร' : '-'],
    ['Timestamp', r.timestamp]
  ];
  const labelW = 330, valX = P + labelW, valW = W - P - valX;
  rows.forEach(([label, value], i) => {
    ctx.font = `600 34px ${FONT}`;
    const lines = wrapText(ctx, value || '-', valW);
    const rowH = Math.max(1, lines.length) * 48 + 24;
    if (i % 2 === 0) { ctx.fillStyle = '#EEF3E6'; ctx.fillRect(P - 16, y, W - P * 2 + 32, rowH); }
    ctx.fillStyle = '#5C6B5F';
    ctx.font = `400 32px ${FONT}`;
    ctx.fillText(label, P, y + 14);
    ctx.fillStyle = '#1D261F';
    ctx.font = `600 34px ${FONT}`;
    lines.forEach((ln, j) => ctx.fillText(ln, valX, y + 12 + j * 48));
    y += rowH;
  });

  // ท้ายใบ
  y += 40;
  ctx.fillStyle = '#7A5230';
  ctx.fillRect(P, y, W - P * 2, 4);
  y += 24;
  ctx.fillStyle = '#5C6B5F';
  ctx.font = `400 28px ${FONT}`;
  ctx.fillText('เวลาในใบนี้เป็นเวลาที่ระบบบันทึก ไม่ใช่เวลาของโทรศัพท์', P, y);
  y += 70;

  // ตัดความสูงให้พอดี
  const out = document.createElement('canvas');
  out.width = W; out.height = y;
  out.getContext('2d').drawImage(c, 0, 0);
  $('receiptImg').src = out.toDataURL('image/png');
  state.receiptBlob = await new Promise(ok => out.toBlob(ok, 'image/png'));
}

/* ================== บันทึก / ส่งเข้าแชท / ปิด ================== */
$('btnSave').onclick = async () => {
  const name = `ลงเวลา_${state.record.refNo}.png`;
  const file = new File([state.receiptBlob], name, { type: 'image/png' });
  if (navigator.canShare && navigator.canShare({ files: [file] })) {
    try { await navigator.share({ files: [file], title: 'ใบยืนยันการลงเวลา' }); return; }
    catch (e) { if (e.name === 'AbortError') return; }
  }
  const a = document.createElement('a');
  a.href = $('receiptImg').src;
  a.download = name;
  document.body.appendChild(a); a.click(); a.remove();
  $('saveHint').textContent = 'ถ้าไฟล์ไม่ถูกบันทึก ให้กดค้างที่รูปด้านบน แล้วเลือก "บันทึกรูปภาพ"';
};

$('btnSend').onclick = async () => {
  if (state.sent) return;
  const ctx = liff.getContext();
  if (!liff.isInClient() || !ctx || ['utou', 'group', 'room', 'square_chat'].indexOf(ctx.type) < 0) {
    $('resultMsg').textContent = 'ส่งเข้าแชทได้เมื่อเปิดแอปจากเมนูในห้องแชท LINE OA ของบริษัท';
    return;
  }
  try {
    await liff.sendMessages([buildFlex(state.record)]);
    state.sent = true;
    $('btnSend').textContent = 'ส่งเข้าแชทแล้ว ✓';
    $('btnSend').disabled = true;
    $('resultMsg').textContent = '';
  } catch (e) {
    $('resultMsg').textContent = 'ส่งไม่สำเร็จ: ' + e.message;
  }
};

$('btnClose').onclick = () => { if (liff.isInClient()) liff.closeWindow(); else window.close(); };

function buildFlex(r) {
  const pass = r.status.indexOf('ผ่าน') === 0;
  const row = (label, value) => ({
    type: 'box', layout: 'baseline', spacing: 'sm', contents: [
      { type: 'text', text: label, size: 'sm', color: '#5C6B5F', flex: 3 },
      { type: 'text', text: String(value || '-'), size: 'sm', color: '#1D261F', flex: 6, wrap: true }
    ]
  });
  return {
    type: 'flex',
    altText: `ลงเวลาเข้างาน ${r.time} ${r.date}`,
    contents: {
      type: 'bubble',
      header: {
        type: 'box', layout: 'vertical', backgroundColor: '#173B22', paddingAll: '16px', contents: [
          { type: 'text', text: 'ลงเวลาเข้างาน', color: '#FFFFFF', weight: 'bold', size: 'lg' },
          { type: 'text', text: 'เลขที่ ' + r.refNo, color: '#CFDCC8', size: 'xs' }
        ]
      },
      body: {
        type: 'box', layout: 'vertical', spacing: 'sm', contents: [
          { type: 'text', text: r.time, weight: 'bold', size: '3xl', color: '#1D261F' },
          { type: 'text', text: `วัน${r.day}ที่ ${r.date}`, size: 'sm', color: '#1D261F' },
          { type: 'text', text: r.status, size: 'sm', weight: 'bold', wrap: true,
            color: pass ? '#2F6B3A' : '#9A6B00', margin: 'md' },
          { type: 'separator', margin: 'md' },
          row('รหัส', r.code),
          row('ชื่อ', r.name),
          row('ตำแหน่ง', r.position),
          row('สถานที่', r.address),
          row('พิกัด GPS', r.gps),
          row('ใกล้ที่สุด', r.nearest),
          row('ระยะห่าง', r.distance !== '' ? r.distance + ' เมตร' : '-')
        ]
      },
      footer: {
        type: 'box', layout: 'vertical', contents: [
          { type: 'button', style: 'primary', color: '#2F6B3A', height: 'sm',
            action: { type: 'uri', label: 'ดูตำแหน่งบนแผนที่', uri: r.mapLink } }
        ]
      }
    }
  };
}

main();
</script>
